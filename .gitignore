# Signing material and secrets
*.p12
*.mobileprovision
*.pem
*.cer
*.p8
*.key
*.keystore
*.certSigningRequest
# Dev-only certificate drop folder read by CertificateAutoImporter at launch. The
# p12/profile patterns above miss `cert.txt`, which holds the password in plaintext.
signing-assets/
.env
.env.*
cert.json
cert.txt

# Python backend
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
Services/WebManager/API/*.db
# WAL sidecars left behind when a run is killed mid-transaction.
Services/WebManager/API/*.db-wal
Services/WebManager/API/*.db-shm
Services/WebManager/API/.venv/
Services/WebManager/Configuration/premium.json

# Cloud signing
Services/Cloud/node_modules/
Services/Cloud/dist/
Services/Cloud/work/
Services/Cloud/*.log

# Private real-device acceptance observations
device-acceptance.local.json
feature-acceptance.local.json

# Native test evidence generated by Tools/Audit/run-native-tests.py
.artifacts/
*.xcresult
