    "Auto sign needs a certificate. Import one in Settings, or turn auto sign off." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج التوقيع التلقائي إلى شهادة. استورد واحدة من الإعدادات، أو عطّل التوقيع التلقائي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatický podpis vyžaduje certifikát. Importujte jej v Nastavení, nebo automatický podpis vypněte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisches Signieren braucht ein Zertifikat. Importiere eines in den Einstellungen oder schalte es aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto sign needs a certificate. Import one in Settings, or turn auto sign off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma automática necesita un certificado. Importa uno en Ajustes o desactiva la firma automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La signature automatique nécessite un certificat. Importez-en un dans les Réglages ou désactivez-la."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanda tangan otomatis memerlukan sertifikat. Impor satu di Pengaturan, atau matikan tanda tangan otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma automatica richiede un certificato. Importane uno in Impostazioni oppure disattivala."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatyczne podpisywanie wymaga certyfikatu. Zaimportuj go w Ustawieniach lub wyłącz tę opcję."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для автоподписи нужен сертификат. Импортируйте его в настройках или отключите автоподпись."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik imzalama bir sertifika gerektirir. Ayarlar'dan bir tane içe aktar ya da otomatik imzalamayı kapat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động ký cần một chứng chỉ. Hãy nhập một chứng chỉ trong Cài đặt, hoặc tắt tự động ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动签名需要证书。请在设置中导入一个，或关闭自动签名。"
          }
        }
      }
    },
