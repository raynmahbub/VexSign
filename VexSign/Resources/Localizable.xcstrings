          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto te permite establecer reglas para reemplazar automáticamente el bundle ID/nombre visible al firmar una app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela vous permet de définir des règles pour remplacer automatiquement le bundle ID/nom d'affichage lors de la signature d'une app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
