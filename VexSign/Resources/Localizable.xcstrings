    "These inject automatically when you sign matching apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحقن هذه تلقائيًا عند توقيع التطبيقات المطابقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto se injektují automaticky, když podepíšete odpovídající aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese werden automatisch injiziert, wenn du passende Apps signierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos se inyectan automáticamente cuando firmas apps que coinciden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceux-ci s’injectent automatiquement lorsque vous signez des apps correspondantes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini diinjeksikan secara otomatis saat Anda menandatangani aplikasi yang cocok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi vengono iniettati automaticamente quando firmi app corrispondenti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te wstrzykują się automatycznie przy podpisywaniu pasujących aplikacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они внедряются автоматически при подписи подходящих приложений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar, eşleşen uygulamaları imzaladığınızda otomatik olarak enjekte edilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những cái này tự động chèn khi bạn ký các ứng dụng phù hợp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你签名匹配的应用时，这些会自动注入。"
          }
        }
      }
    },
    "These settings control how background downloads from sources appear. Manual downloads will always show with their own header." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحكم هذه الإعدادات في كيفية ظهور التنزيلات في الخلفية من المصادر. ستظهر التنزيلات اليدوية دائمًا بترويستها الخاصة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato nastavení řídí, jak se zobrazují stahování ze zdrojů na pozadí. Ruční stahování se vždy zobrazí s vlastním záhlavím."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen steuern, wie Hintergrund-Downloads aus Quellen angezeigt werden. Manuelle Downloads werden immer mit ihrer eigenen Kopfzeile angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos ajustes controlan cómo aparecen las descargas en segundo plano de las fuentes. Las descargas manuales siempre se muestran con su propio encabezado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces réglages contrôlent l’affichage des téléchargements en arrière-plan provenant des sources. Les téléchargements manuels s’affichent toujours avec leur propre en-tête."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan ini mengontrol cara unduhan latar belakang dari sumber ditampilkan. Unduhan manual akan selalu ditampilkan dengan header-nya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste impostazioni controllano come appaiono i download in background dalle fonti. I download manuali mostreranno sempre la propria intestazione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ustawienia kontrolują sposób wyświetlania pobierań w tle ze źródeł. Pobierania ręczne zawsze pokazują się z własnym nagłówkiem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти настройки управляют тем, как отображаются фоновые загрузки из источников. Ручные загрузки всегда показываются с собственным заголовком."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayarlar, kaynaklardan gelen arka plan indirmelerinin nasıl görüneceğini kontrol eder. Manuel indirmeler her zaman kendi başlığıyla görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các cài đặt này kiểm soát cách hiển thị tải xuống nền từ các nguồn. Tải xuống thủ công luôn hiển thị với tiêu đề riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些设置控制来自源的后台下载的显示方式。手动下载始终会显示其自己的顶栏。"
          }
        }
      }
    },
    "This action cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto akci nelze vrátit zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
