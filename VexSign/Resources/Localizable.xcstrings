    "Server: your certificate is sent over HTTPS, the update is signed remotely, and iOS installs it. No pairing file needed." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخادم: تُرسَل شهادتك عبر HTTPS، ويُوقَّع التحديث عن بُعد، ثم يثبّته iOS. لا حاجة لملف اقتران."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server: váš certifikát se odešle přes HTTPS, aktualizace se podepíše vzdáleně a iOS ji nainstaluje. Párovací soubor není potřeba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server: Dein Zertifikat wird über HTTPS gesendet, das Update wird remote signiert und iOS installiert es. Keine Pairing-Datei nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server: your certificate is sent over HTTPS, the update is signed remotely, and iOS installs it. No pairing file needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor: tu certificado se envía por HTTPS, la actualización se firma de forma remota e iOS la instala. No se necesita archivo de emparejamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveur : votre certificat est envoyé via HTTPS, la mise à jour est signée à distance et iOS l'installe. Aucun fichier d'appairage requis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server: sertifikat Anda dikirim melalui HTTPS, pembaruan ditandatangani dari jarak jauh, dan iOS memasangnya. Tidak perlu berkas pemasangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server: il tuo certificato viene inviato via HTTPS, l'aggiornamento viene firmato da remoto e iOS lo installa. Nessun file di associazione necessario."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer: Twój certyfikat jest wysyłany przez HTTPS, aktualizacja jest podpisywana zdalnie, a iOS ją instaluje. Plik parowania nie jest potrzebny."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер: ваш сертификат отправляется по HTTPS, обновление подписывается удалённо, и iOS его устанавливает. Файл сопряжения не нужен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu: sertifikanız HTTPS üzerinden gönderilir, güncelleme uzaktan imzalanır ve iOS onu yükler. Eşleştirme dosyası gerekmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ: chứng chỉ của bạn được gửi qua HTTPS, bản cập nhật được ký từ xa và iOS cài đặt. Không cần tệp ghép nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器：你的证书通过 HTTPS 发送，更新在远端签名，由 iOS 安装。无需配对文件。"
          }
        }
      }
    },
    "Set a password — until you do, the server stays open to anyone on the network." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن كلمة مرور — إلى أن تفعل ذلك، يظل الخادم مفتوحاً لأي شخص على الشبكة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte heslo — dokud to neuděláte, server zůstává otevřený komukoli v síti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege ein Passwort fest — bis dahin bleibt der Server für jeden im Netzwerk offen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a password — until you do, the server stays open to anyone on the network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece una contraseña — hasta entonces, el servidor permanece abierto a cualquiera en la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un mot de passe — tant que ce n'est pas fait, le serveur reste ouvert à tous sur le réseau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur kata sandi — sampai Anda melakukannya, server tetap terbuka untuk siapa pun di jaringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta una password — finché non lo fai, il server resta aperto a chiunque sulla rete."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw hasło — dopóki tego nie zrobisz, serwer pozostaje otwarty dla każdego w sieci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте пароль — пока вы этого не сделаете, сервер открыт для всех в сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şifre belirleyin — belirleyene kadar sunucu ağdaki herkese açık kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt mật khẩu — cho đến khi bạn làm vậy, máy chủ vẫn mở cho bất kỳ ai trong mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请设置密码 — 在此之前，服务器对网络中的任何人开放。"
          }
        }
      }
    },
