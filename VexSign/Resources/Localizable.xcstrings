    "Default injection path and folder. Library tweaks set to use custom settings override these." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسار ومجلد الحقن الافتراضيان. تتجاوز هذه القيم تعديلات المكتبة المضبوطة على استخدام إعدادات مخصصة."
          }
        },
        "cs" : {
