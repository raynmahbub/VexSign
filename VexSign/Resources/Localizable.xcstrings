    "Reopen the Save to Files picker at the last folder you used instead of always starting at the VexSign documents folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة فتح مُنتقي ‏«حفظ في الملفات» عند آخر مجلد استخدمته بدلًا من البدء دائمًا من مجلد مستندات VexSign."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu otevře výběr Uložit do Souborů v naposledy použité složce místo toho, aby vždy začínal ve složce dokumentů VexSign."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Auswahl „In Dateien sichern“ wieder im zuletzt verwendeten Ordner, statt immer im VexSign-Dokumentenordner zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
