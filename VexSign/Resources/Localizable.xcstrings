    "Sign with the certificate you first installed VexSign with, or iOS won't update it in place." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقّع بالشهادة التي ثبّت بها VexSign في البداية، وإلا فلن يحدّثه iOS في مكانه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podepište certifikátem, kterým jste VexSign původně nainstalovali, jinak jej iOS neaktualizuje na místě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signiere mit dem Zertifikat, mit dem du VexSign ursprünglich installiert hast, sonst aktualisiert iOS es nicht direkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign with the certificate you first installed VexSign with, or iOS won't update it in place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma con el certificado con el que instalaste VexSign por primera vez, o iOS no lo actualizará en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signez avec le certificat utilisé lors de la première installation de VexSign, sinon iOS ne le mettra pas à jour sur place."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanda tangani dengan sertifikat yang Anda gunakan saat pertama memasang VexSign, atau iOS tidak akan memperbaruinya di tempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma con il certificato con cui hai installato VexSign la prima volta, altrimenti iOS non lo aggiornerà sul posto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpisz certyfikatem, którym pierwotnie zainstalowano VexSign, w przeciwnym razie iOS nie zaktualizuje go w miejscu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпишите тем сертификатом, которым вы изначально установили VexSign, иначе iOS не обновит его на месте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign'i ilk kurduğunuz sertifikayla imzalayın, aksi halde iOS onu yerinde güncellemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ký bằng chứng chỉ bạn đã dùng khi cài VexSign lần đầu, nếu không iOS sẽ không cập nhật tại chỗ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用你最初安装 VexSign 时所用的证书签名，否则 iOS 不会就地更新。"
          }
        }
      }
    },
