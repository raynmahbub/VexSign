    "Needs CydiaSubstrate. The app doesn't include it, so VexSign adds ElleKit automatically when signing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج إلى CydiaSubstrate. التطبيق لا يتضمنه، لذا يضيف VexSign بديل ElleKit تلقائيًا عند التوقيع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžaduje CydiaSubstrate. Aplikace ho neobsahuje, takže VexSign při podepisování automaticky přidá ElleKit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benötigt CydiaSubstrate. Die App enthält es nicht, daher fügt VexSign beim Signieren automatisch ElleKit hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesita CydiaSubstrate. La app no lo incluye, así que VexSign añade ElleKit automáticamente al firmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite CydiaSubstrate. L’app ne l’inclut pas, donc VexSign ajoute automatiquement ElleKit lors de la signature."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membutuhkan CydiaSubstrate. Aplikasi tidak menyertakannya, jadi VexSign menambahkan ElleKit secara otomatis saat menandatangani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede CydiaSubstrate. L'app non lo include, quindi VexSign aggiunge automaticamente ElleKit durante la firma."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymaga CydiaSubstrate. Aplikacja go nie zawiera, więc VexSign automatycznie dodaje ElleKit podczas podpisywania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требует CydiaSubstrate. Приложение его не содержит, поэтому VexSign автоматически добавляет ElleKit при подписи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CydiaSubstrate gerektirir. Uygulama bunu içermiyor, bu yüzden VexSign imzalarken otomatik olarak ElleKit ekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần CydiaSubstrate. Ứng dụng không có sẵn nó, nên VexSign tự động thêm ElleKit khi ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 CydiaSubstrate。应用未包含它，因此 VexSign 会在签名时自动添加 ElleKit。"
          }
        }
      }
