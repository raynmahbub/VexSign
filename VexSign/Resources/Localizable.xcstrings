    "This enables liquid glass for this app, this requires a restart of the app to take effect." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يفعّل Liquid Glass لهذا التطبيق، ويتطلب إعادة تشغيل التطبيق حتى يتم تطبيقه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto se pro tuto aplikaci povolí Liquid Glass, k projevení změny je nutný restart aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies aktiviert „Liquid Glass“ für dieser App, dies erfordert einen Neustart der App um wirksam zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This enables liquid glass for this app, this requires a restart of the app to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto activa Liquid Glass para esta app; requiere reiniciar la app para que surta efecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela active Liquid Glass pour cette app, un redémarrage de l'app est nécessaire pour prendre effet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini mengaktifkan liquid glass untuk aplikasi ini, dan memerlukan mulai ulang aplikasi agar berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo abilita il liquid glass per l'app, questo richiede un riavvio dell'app per dare effetto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącza liquid glass dla tej aplikacji. Wymaga ponownego uruchomienia, aby zmiany zostały zastosowane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
