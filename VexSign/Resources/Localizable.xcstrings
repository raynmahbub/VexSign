          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt jeden Typ zurück, sodass er wieder dort öffnet, wo du zuletzt warst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puts every type back to reopening where you last browsed."
          }
