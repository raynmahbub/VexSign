          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard-Injektionspfad und -ordner. Bibliotheks-Tweaks mit eigenen Einstellungen überschreiben diese."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruta y carpeta de inyección predeterminadas. Los tweaks de la biblioteca configurados para usar ajustes personalizados las anulan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
