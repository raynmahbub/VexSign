    "Nothing here. Tweaks you add land here unless filed in a folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد شيء هنا. تظهر التعديلات التي تضيفها هنا ما لم تُصنّف في مجلد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tady nic není. Přidané tweaky se objeví zde, pokud je nezařadíte do složky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier ist nichts. Tweaks, die du hinzufügst, landen hier, sofern sie nicht in einem Ordner abgelegt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí no hay nada. Los tweaks que añadas aparecen aquí salvo que los archives en una carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ici. Les tweaks que vous ajoutez arrivent ici sauf s’ils sont classés dans un dossier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada apa-apa di sini. Tweak yang Anda tambahkan akan muncul di sini kecuali diarsipkan dalam folder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente qui. I tweak che aggiungi finiscono qui a meno che non vengano archiviati in una cartella."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nic nie ma. Dodawane tweaki trafiają tutaj, chyba że zostaną umieszczone w folderze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь пусто. Добавляемые твики попадают сюда, если не помещены в папку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada hiçbir şey yok. Eklediğiniz tweak'ler bir klasöre konmazsa burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có gì ở đây. Các tweak bạn thêm sẽ nằm ở đây trừ khi được sắp vào thư mục."
          }
        },
        "zh-Hans" : {
