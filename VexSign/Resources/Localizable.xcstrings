    "Only apps updated on or after this date are sent by the repository server." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل خادم المستودع التطبيقات المُحدّثة في هذا التاريخ أو بعده فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server repozitáře pošle jen aplikace aktualizované od tohoto data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Repository-Server sendet nur Apps, die an oder nach diesem Datum aktualisiert wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only apps updated on or after this date are sent by the repository server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor del repositorio solo envía apps actualizadas en esta fecha o después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur du dépôt n'envoie que les applications mises à jour à partir de cette date."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server repositori hanya mengirim aplikasi yang diperbarui pada atau setelah tanggal ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server del repository invia solo le app aggiornate a partire da questa data."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer repozytorium wysyła tylko aplikacje zaktualizowane w tym dniu lub później."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер репозитория отправляет только приложения, обновлённые с этой даты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depo sunucusu yalnızca bu tarihte veya sonrasında güncellenen uygulamaları gönderir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ kho chỉ gửi ứng dụng được cập nhật từ ngày này trở đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仓库服务器只发送在该日期当天或之后更新的应用。"
          }
        }
      }
    },
    "Only the newest apps are sent by the repository server, so premium repositories load much faster." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل خادم المستودع أحدث التطبيقات فقط، لذا تُحمّل المستودعات المميزة أسرع بكثير."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server repozitáře pošle jen nejnovější aplikace, takže se prémiové repozitáře načtou mnohem rychleji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Repository-Server sendet nur die neuesten Apps, dadurch laden Premium-Repositories deutlich schneller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the newest apps are sent by the repository server, so premium repositories load much faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor del repositorio solo envía las apps más recientes, así los repositorios premium cargan mucho más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur du dépôt n'envoie que les applications les plus récentes, les dépôts premium se chargent donc bien plus vite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server repositori hanya mengirim aplikasi terbaru, sehingga repositori premium dimuat jauh lebih cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server del repository invia solo le app più recenti, così i repository premium si caricano molto più in fretta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer repozytorium wysyła tylko najnowsze aplikacje, więc repozytoria premium wczytują się dużo szybciej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер репозитория отправляет только новые приложения, поэтому премиум-репозитории загружаются намного быстрее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depo sunucusu yalnızca en yeni uygulamaları gönderir, böylece premium depolar çok daha hızlı yüklenir."
