    "You cannot update '%@' with itself, please use an alternative tool to update it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكنك تحديث '%@' بنفسه، يرجى استخدام أداة بديلة لتحديثه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze aktualizovat „%@“ sebou samým, použijte k aktualizaci jiný nástroj."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst „%@“ nicht mit sich selbst aktualisieren, bitte verwende ein anderes Werkzeug, um es zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes actualizar '%@' consigo mismo, usa una herramienta alternativa para actualizarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas mettre à jour « %@ » avec lui-même, veuillez utiliser un autre outil pour le mettre à jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak dapat memperbarui '%@' dengan dirinya sendiri, gunakan alat alternatif untuk memperbaruinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi aggiornare '%@' con se stesso, usa uno strumento alternativo per aggiornarlo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie możesz zaktualizować „%@” za pomocą jej samej, użyj alternatywnego narzędzia, aby ją zaktualizować."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нельзя обновить «%@» им же самим, используйте для обновления другой инструмент."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' kendisiyle güncellenemez, güncellemek için lütfen alternatif bir araç kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không thể cập nhật '%@' bằng chính nó, vui lòng dùng công cụ khác để cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你无法用“%@”自身来更新它，请使用其他工具进行更新。"
          }
        }
      }
    },
