    "VexSign is free software under the GPL-3.0 license, derived from VexSign by claration. The complete corresponding source is available at the Source Code link above." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign برنامج حر بموجب ترخيص GPL-3.0، مشتق من VexSign بواسطة claration. الكود المصدري الكامل المقابل متاح عبر رابط الكود المصدري أعلاه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign je svobodný software pod licencí GPL-3.0, odvozený z VexSign od claration. Kompletní odpovídající zdrojový kód je dostupný přes odkaz Zdrojový kód výše."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign ist freie Software unter der GPL-3.0-Lizenz, abgeleitet von VexSign von claration. Der vollständige zugehörige Quellcode ist über den Link „Quellcode“ oben verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign es software libre bajo la licencia GPL-3.0, derivado de VexSign de claration. El código fuente correspondiente completo está disponible en el enlace Código fuente de arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign est un logiciel libre sous licence GPL-3.0, dérivé de VexSign par claration. Le code source complet correspondant est disponible via le lien Code source ci-dessus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign adalah perangkat lunak bebas di bawah lisensi GPL-3.0, diturunkan dari VexSign oleh claration. Sumber lengkap yang sesuai tersedia di tautan Source Code di atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign è software libero sotto licenza GPL-3.0, derivato da VexSign di claration. Il codice sorgente completo corrispondente è disponibile al link Codice sorgente qui sopra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign to wolne oprogramowanie na licencji GPL-3.0, oparte na VexSign autorstwa Samary (claration). Kompletny odpowiadający kod źródłowy jest dostępny pod linkiem Kod źródłowy powyżej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign — свободное ПО под лицензией GPL-3.0, основанное на VexSign от claration. Полный исходный код доступен по ссылке «Исходный код» выше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign, claration tarafından geliştirilen VexSign'dan türetilen, GPL-3.0 lisansı altındaki özgür bir yazılımdır. İlgili kaynak kodun tamamı yukarıdaki Source Code bağlantısında mevcuttur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign là phần mềm tự do theo giấy phép GPL-3.0, dựa trên VexSign của claration. Toàn bộ mã nguồn tương ứng có sẵn tại liên kết Source Code phía trên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign 是基于 GPL-3.0 许可证的自由软件，衍生自 claration 的 VexSign。完整的对应源代码可通过上方的源代码链接获取。"
          }
        }
      }
    },
    "VexSign unpacks the .deb and injects each dylib/framework and copies bundles automatically." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفك VexSign ضغط ملف .deb ويحقن كل dylib/framework وينسخ الـ bundles تلقائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign rozbalí .deb, injektuje každý dylib/framework a automaticky zkopíruje bundly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign entpackt die .deb, injiziert jede dylib/jedes Framework und kopiert Bundles automatisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign descomprime el .deb e inyecta cada dylib/framework y copia los bundles automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign décompresse le .deb, injecte chaque dylib/framework et copie les bundles automatiquement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign membongkar .deb dan menginjeksikan setiap dylib/framework serta menyalin bundle secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign decomprime il .deb, inietta ogni dylib/framework e copia automaticamente i bundle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign rozpakowuje plik .deb, wstrzykuje każdy dylib/framework i automatycznie kopiuje bundle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign распаковывает .deb, внедряет каждую dylib/framework и автоматически копирует bundle."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign, .deb dosyasını açar, her dylib/framework'ü enjekte eder ve bundle'ları otomatik olarak kopyalar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign giải nén .deb và chèn từng dylib/framework, đồng thời tự động sao chép các bundle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VexSign 会自动解包 .deb，注入其中的每个 dylib/framework 并复制 bundle。"
          }
        }
      }
    },
    "VexSign will restart to apply the backup." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
