          }
        }
      }
    },
    "Frees cached icons and web data every time an install finishes. They rebuild as you browse." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحرر الأيقونات وبيانات الويب المخزنة مؤقتًا في كل مرة ينتهي فيها التثبيت. تُعاد بناؤها أثناء التصفح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvolní mezipaměť ikon a webových dat po každé dokončené instalaci. Znovu se vytvoří při procházení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt zwischengespeicherte Symbole und Webdaten frei, sobald eine Installation abgeschlossen ist. Sie werden beim Stöbern neu aufgebaut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frees cached icons and web data every time an install finishes. They rebuild as you browse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera los iconos y datos web en caché cada vez que termina una instalación. Se reconstruyen mientras navegas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libère les icônes et données web en cache à chaque fin d'installation. Elles se reconstruisent au fil de votre navigation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membebaskan ikon dan data web yang di-cache setiap kali pemasangan selesai. Semuanya dibangun ulang saat Anda menjelajah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera icone e dati web nella cache ogni volta che un'installazione termina. Vengono ricreati mentre navighi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwalnia zapisane w pamięci podręcznej ikony i dane sieciowe po każdej zakończonej instalacji. Odtwarzają się podczas przeglądania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освобождает кэшированные иконки и веб-данные после каждой установки. Они создаются заново по мере просмотра."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kurulum bittiğinde önbelleğe alınan simgeleri ve web verilerini boşaltır. Gezindikçe yeniden oluşturulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giải phóng biểu tượng và dữ liệu web đã lưu trong bộ nhớ đệm mỗi khi cài đặt xong. Chúng sẽ được tạo lại khi bạn duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次安装完成后释放缓存的图标和网页数据。浏览时会自动重建。"
          }
        }
      }
    },
    "Delete After Installing drops the signed app from your library once it finishes installing. It stays installed on your device." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل خيار الحذف بعد التثبيت التطبيق الموقّع من مكتبتك بمجرد انتهاء التثبيت. يبقى مثبتًا على جهازك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranit po instalaci vyřadí podepsanou aplikaci z knihovny, jakmile se instalace dokončí. Na zařízení zůstane nainstalovaná."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Löschen nach Installation“ entfernt die signierte App aus deiner Bibliothek, sobald die Installation abgeschlossen ist. Auf deinem Gerät bleibt sie installiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete After Installing drops the signed app from your library once it finishes installing. It stays installed on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar tras instalar quita la app firmada de tu biblioteca en cuanto termina de instalarse. Sigue instalada en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer après l'installation retire l'app signée de votre bibliothèque dès la fin de l'installation. Elle reste installée sur votre appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus Setelah Pemasangan membuang aplikasi yang ditandatangani dari pustaka Anda setelah pemasangan selesai. Aplikasi tetap terpasang di perangkat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina dopo l'installazione rimuove l'app firmata dalla libreria al termine dell'installazione. Resta installata sul dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń po instalacji kasuje podpisaną aplikację z biblioteki po zakończeniu instalacji. Pozostaje ona zainstalowana na urządzeniu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Удалить после установки» убирает подписанное приложение из библиотеки, как только установка завершится. На устройстве оно остаётся установленным."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulumdan Sonra Sil, kurulum tamamlanır tamamlanmaz imzalanmış uygulamayı kitaplığınızdan kaldırır. Uygulama cihazınızda kurulu kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa sau khi cài đặt sẽ gỡ ứng dụng đã ký khỏi thư viện ngay khi cài đặt xong. Ứng dụng vẫn được cài trên thiết bị của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“安装后删除”会在安装完成后将已签名的应用从资料库中移除。应用仍安装在你的设备上。"
          }
        }
      }
    },
    "Automatic Cleanup" : {
      "extractionState" : "manual",
      "localizations" : {
