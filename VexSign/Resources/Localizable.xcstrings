    "Frameworks the tweak links against. Add a missing one as another file if the tweak needs it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الـ frameworks التي يرتبط بها التعديل. أضف الناقص منها كملف آخر إذا احتاجه التعديل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frameworky, na které se tweak odkazuje. Chybějící přidejte jako další soubor, pokud ho tweak potřebuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frameworks, gegen die der Tweak gelinkt ist. Füge ein fehlendes als weitere Datei hinzu, wenn der Tweak es benötigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frameworks contra los que enlaza el tweak. Añade uno que falte como otro archivo si el tweak lo necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frameworks auxquels le tweak est lié. Ajoutez-en un manquant comme fichier supplémentaire si le tweak en a besoin."
