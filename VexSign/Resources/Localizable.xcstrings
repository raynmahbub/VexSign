    "Open it in a browser on your computer to upload files and manage your apps, certificates and tweaks over your local network." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتحه في متصفح على جهاز الكمبيوتر لرفع الملفات وإدارة تطبيقاتك وشهاداتك و tweaks عبر شبكتك المحلية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevři ho v prohlížeči na počítači, abys nahrával soubory a spravoval aplikace, certifikáty a tweaky přes místní síť."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne ihn im Browser deines Computers, um Dateien hochzuladen und deine Apps, Zertifikate und Tweaks über dein lokales Netzwerk zu verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ábrelo en un navegador en tu ordenador para subir archivos y gestionar tus apps, certificados y tweaks en tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre-le dans un navigateur sur ton ordinateur pour téléverser des fichiers et gérer tes apps, certificats et tweaks sur ton réseau local."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka di browser komputer untuk mengunggah file dan mengelola aplikasi, sertifikat, dan tweak melalui jaringan lokal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprilo in un browser sul tuo computer per caricare file e gestire app, certificati e tweak sulla tua rete locale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz go w przeglądarce na komputerze, aby przesyłać pliki i zarządzać aplikacjami, certyfikatami i tweakami przez sieć lokalną."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте его в браузере на компьютере, чтобы загружать файлы и управлять приложениями, сертификатами и твиками в локальной сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya yüklemek ve uygulamalarını, sertifikalarını ve tweak'lerini yerel ağ üzerinden yönetmek için bilgisayarındaki bir tarayıcıda aç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở trên trình duyệt máy tính để tải tệp lên và quản lý ứng dụng, chứng chỉ và tweak qua mạng nội bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在电脑的浏览器中打开，即可通过本地网络上传文件并管理你的应用、证书和插件。"
          }
        }
      }
    },
