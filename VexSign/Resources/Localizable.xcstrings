        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a abrir el selector Guardar en Archivos en la última carpeta usada en lugar de empezar siempre en la carpeta de documentos de VexSign."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rouvre le sélecteur « Enregistrer dans Fichiers » sur le dernier dossier utilisé au lieu de toujours démarrer dans le dossier de documents VexSign."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka kembali pemilih Simpan ke Berkas di folder terakhir yang Anda gunakan alih-alih selalu mulai di folder dokumen VexSign."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riapre il selettore Salva su File nell’ultima cartella usata invece di partire sempre dalla cartella documenti di VexSign."
          }
        },
        "pl" : {
          "stringUnit" : {
