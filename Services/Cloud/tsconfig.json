{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "sourceMap": true,
    "skipLibCheck": true,
    "rootDir": "."
  },
  "include": [
    "API/**/*.ts",
    "Config/**/*.ts",
    "Storage/**/*.ts",
    "Security/**/*.ts",
    "Signing/**/*.ts",
    "VexSignTests/**/*.ts"
  ]
}
