{
  "name": "@vexsign/cloud-signing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/API/main.js",
    "worker": "node dist/Signing/Worker/worker.js",
    "migrate": "node dist/Storage/migrate.js",
    "test": "tsx --test Tests/*.test.ts",
    "check": "tsc --noEmit",
    "contracts": "tsx API/openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/lib-storage": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "bullmq": "^6.7.8",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
