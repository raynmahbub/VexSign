# Non-secret placeholders only. Copy to an untracked .env and replace all values.
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@database:5432/vexsign
REDIS_URL=rediss://REPLACE_USER:REPLACE_PASSWORD@redis:6379
S3_ENDPOINT=https://REPLACE_STORAGE_HOST
S3_REGION=us-east-1
S3_BUCKET=REPLACE_PRIVATE_BUCKET
# S3_KMS_KEY_ID=REPLACE_KMS_KEY
PUBLIC_ORIGIN=https://REPLACE_PUBLIC_HOST
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt-public.pem
JWT_ISSUER=https://REPLACE_IDENTITY_PROVIDER
JWT_AUDIENCE=vexsign-signing
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SIGNER_EXECUTABLE=/opt/vexsign/sandbox-launcher
SIGNING_CONCURRENCY=2
WEBHOOK_ALLOWLIST=
TRUSTED_PROXIES=
PORT=8080
