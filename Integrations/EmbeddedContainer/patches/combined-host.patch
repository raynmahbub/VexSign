diff --git a/LiveContainer/LCSharedUtils.h b/LiveContainer/LCSharedUtils.h
index daf7b7b..83b23b4 100644
--- a/LiveContainer/LCSharedUtils.h
+++ b/LiveContainer/LCSharedUtils.h
@@ -19,0 +20,6 @@
+// VexSign combined-host bridge. No account/keychain values cross this API.
++ (BOOL)vexSignCombinedHostAvailable;
++ (BOOL)vexSignOpenPrimary;
++ (BOOL)vexSignStageIPA:(NSURL *)source;
+// Read-only inventory: imported means present in the host, not runnable or iOS-installed.
