diff --git a/LiveContainer/LCSharedUtils.m b/LiveContainer/LCSharedUtils.m
index 575205f..d8591b8 100644
--- a/LiveContainer/LCSharedUtils.m
+++ b/LiveContainer/LCSharedUtils.m
@@ -434,0 +435,97 @@ NSString* FBSOpenApplicationOptionKeyPayloadURL = @"__PayloadURL";
+
+// VexSign additions; distributed with the upstream AGPL-3.0 host.
++ (BOOL)vexSignCombinedHostAvailable {
+    return [lcMainBundle.infoDictionary[@"VexSignCombinedHost"] boolValue]
+        && getenv("LC_HOME_PATH") != NULL;
+}
+
++ (BOOL)vexSignOpenPrimary {
+    if (![lcMainBundle.infoDictionary[@"VexSignPrimaryHost"] boolValue]) return NO;
+    return [self launchToGuestAppWithURL:[NSURL URLWithString:@"livecontainer://livecontainer-launch?bundle-name=vexsign-primary"]];
+}
+
++ (BOOL)vexSignStageIPA:(NSURL *)source {
+    @synchronized(self) {
+    if (![self vexSignCombinedHostAvailable] || !source.isFileURL
+        || [lcUserDefaults stringForKey:@"VexSignPendingImport"]) return NO;
+    NSURL *canonical = source.URLByStandardizingPath.URLByResolvingSymlinksInPath;
+    NSString *home = [NSURL fileURLWithPath:NSHomeDirectory()].URLByResolvingSymlinksInPath.path;
+    NSNumber *regular = nil;
+    if (![canonical.path hasPrefix:[home stringByAppendingString:@"/"]]
+        || ![canonical.pathExtension.lowercaseString isEqualToString:@"ipa"]
+        || ![canonical getResourceValue:&regular forKey:NSURLIsRegularFileKey error:nil]
+        || !regular.boolValue) return NO;
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSURL *documents = [[[NSURL fileURLWithPath:@(getenv("LC_HOME_PATH"))]
+                         URLByAppendingPathComponent:@"Documents" isDirectory:YES] URLByResolvingSymlinksInPath];
+    NSURL *inbox = [documents URLByAppendingPathComponent:@"Inbox" isDirectory:YES];
+    NSURL *resolvedInbox = inbox.URLByResolvingSymlinksInPath;
+    if (![resolvedInbox.URLByDeletingLastPathComponent.path isEqualToString:documents.path]
+        || ![resolvedInbox.lastPathComponent isEqualToString:@"Inbox"]) return NO;
+    if (![fm createDirectoryAtURL:inbox withIntermediateDirectories:YES attributes:nil error:nil]) return NO;
+    NSString *name = [NSString stringWithFormat:@"VexSign-%@.ipa", NSUUID.UUID.UUIDString];
+    NSURL *destination = [inbox URLByAppendingPathComponent:name];
+    if (![fm copyItemAtURL:canonical toURL:destination error:nil]) {
+        [fm removeItemAtURL:destination error:nil];
+        return NO;
+    }
+    [lcUserDefaults setObject:destination.path forKey:@"VexSignPendingImport"];
+    // A host session switch can terminate the guest immediately after staging.
+    if (![lcUserDefaults synchronize]) {
+        [lcUserDefaults removeObjectForKey:@"VexSignPendingImport"];
+        [fm removeItemAtURL:destination error:nil];
+        return NO;
+    }
+    return YES;
+    }
+}
+
++ (NSDictionary *)vexSignGuestInfo:(NSString *)identifier {
+    if (![self vexSignCombinedHostAvailable] || identifier.length == 0 || identifier.length > 255) return nil;
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSURL *home = [NSURL fileURLWithPath:@(getenv("LC_HOME_PATH"))];
+    NSURL *local = [home URLByAppendingPathComponent:@"Documents/Applications" isDirectory:YES];
+    NSURL *group = [self appGroupPath];
+    NSMutableArray<NSURL *> *roots = [NSMutableArray arrayWithObject:local];
+    if (group) [roots addObject:[group URLByAppendingPathComponent:@"LiveContainer/Applications" isDirectory:YES]];
+    // If the shared inventory cannot be addressed, an absent local match is unknown.
+    BOOL complete = group != nil;
+    for (NSURL *root in roots) {
+        NSURL *canonicalRoot = root.URLByStandardizingPath.URLByResolvingSymlinksInPath;
+        NSError *error = nil;
+        NSArray<NSURL *> *entries = [fm contentsOfDirectoryAtURL:canonicalRoot
+            includingPropertiesForKeys:@[NSURLIsDirectoryKey] options:0 error:&error];
+        if (!entries) {
+            if (![error.domain isEqualToString:NSCocoaErrorDomain]
+                || (error.code != NSFileReadNoSuchFileError && error.code != NSFileNoSuchFileError)) complete = NO;
+            continue;
+        }
+        if (entries.count > 1000) { complete = NO; continue; }
+        for (NSURL *entry in entries) {
+            NSURL *app = entry.URLByStandardizingPath.URLByResolvingSymlinksInPath;
+            NSNumber *directory = nil;
+            if (![app.URLByDeletingLastPathComponent.path isEqualToString:canonicalRoot.path]
+                || ![app getResourceValue:&directory forKey:NSURLIsDirectoryKey error:nil]) { complete = NO; continue; }
+            if (!directory.boolValue) continue;
+            NSURL *info = [app URLByAppendingPathComponent:@"Info.plist"].URLByResolvingSymlinksInPath;
+            NSNumber *size = nil;
+            if (![info.URLByDeletingLastPathComponent.path isEqualToString:app.path]
+                || ![info getResourceValue:&size forKey:NSURLFileSizeKey error:nil]
+                || size.unsignedLongLongValue > 1024 * 1024) { complete = NO; continue; }
+            // Read only bounded, contained Info.plists. No guest keychain/data crosses this bridge.
+            NSFileHandle *handle = [NSFileHandle fileHandleForReadingFromURL:info error:nil];
+            NSData *data = [handle readDataUpToLength:1024 * 1024 + 1 error:nil];
+            [handle closeAndReturnError:nil];
+            if (!data || data.length > 1024 * 1024) { complete = NO; continue; }
+            id plist = data ? [NSPropertyListSerialization propertyListWithData:data options:NSPropertyListImmutable format:nil error:nil] : nil;
+            if (![plist isKindOfClass:NSDictionary.class]) { complete = NO; continue; }
+            if (![plist[@"CFBundleIdentifier"] isEqual:identifier]) continue;
+            NSMutableDictionary *result = [NSMutableDictionary dictionaryWithObject:@"imported" forKey:@"state"];
+            id version = plist[@"CFBundleShortVersionString"];
+            if ([version isKindOfClass:NSString.class]) result[@"version"] = version;
+            return result;
+        }
+    }
+    return complete ? @{@"state": @"notImported"} : nil;
+}
+
